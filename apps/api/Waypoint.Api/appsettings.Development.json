{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Waypoint": {
    // Dev-only test accounts (see docs/09-phased-plan.md phase notes) — kept here rather than in
    // the base appsettings.json specifically so a production deployment that forgets to set
    // Waypoint__AdminEmails starts with an empty, safe-by-default admin allowlist instead of
    // silently granting admin rights to leftover local test emails.
    "AdminEmails": [ "sam.phase2@example.com", "phase8admin@example.com" ]
  }
}
