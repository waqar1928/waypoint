# Production environment template for docker-compose.prod.yml, meant to live on the Hostinger
# VPS only. Copy this to `.env` next to docker-compose.prod.yml on the VPS and fill in real
# values there. This file itself must only ever contain placeholders — never copy real secrets
# back into this example file, and never commit the real `.env` (it's excluded in .gitignore).
#
# See docs/ENVIRONMENT_VARIABLES.md for what each variable does, who reads it, and which ones
# are required vs optional. See docs/HOSTINGER_DEPLOYMENT.md for how to generate/obtain each
# value on the actual VPS.

# ---- PostgreSQL ------------------------------------------------------------
# Required. Generate a strong, random password on the VPS itself (e.g. `openssl rand -base64 32`)
# — never reuse the local dev password (waypoint_dev_password) in production.
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# ---- Application URLs -------------------------------------------------------
# Required. The public URL users load the app at. Used for: CORS origin allowlist, links in
# transactional emails, the frontend's canonical URL (metadata/sitemap/robots), and is baked into
# the web container's JS bundle at build time (see apps/web/Dockerfile).
WEB_APP_BASE_URL=https://app.drevia.net

# ---- AI (Drevia Coach) -------------------------------------------------------
# Optional. Without this, Drevia Coach fails gracefully (returns a clear "not configured yet"
# error to the user) instead of crashing the app — see AnthropicAiService.cs. Never exposed to
# the browser; only read server-side by the api container.
ANTHROPIC_API_KEY=CHANGE_ME

# ---- Email (SMTP) -----------------------------------------------------------
# Optional as a group. Leave SMTP_HOST empty and the API logs emails to its own container output
# instead of sending them (safe fallback, not a broken state) — see LoggingEmailSender.cs. Set
# all of these together once you have a real transactional-email provider or mail relay.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_ADDRESS=no-reply@drevia.net
SMTP_FROM_NAME=Drevia

# ---- Push notifications (VAPID) --------------------------------------------
# Required as a group before this deploy can start — Program.cs fails fast at startup outside
# Development if these three aren't all set together (see the same fail-fast pattern already
# used for Waypoint__DataProtection__KeysDirectory). Generate the keypair once, outside this
# repo and outside any chat session, e.g. `npx web-push generate-vapid-keys` run locally or
# directly on the VPS — see docs/HOSTINGER_DEPLOYMENT.md Step 7 for the full procedure. Never
# reuse a keypair generated for local development; never commit the private key anywhere.
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
# Must be a real, monitored mailto: address or an https:// URL identifying who to contact about
# this VAPID application server, per the Web Push spec — push services may use it to reach you
# about delivery problems. A placeholder value is accepted by the app (no format validation is
# implemented) but is not a valid production value.
VAPID_SUBJECT=CHANGE_ME

# ---- Admin role allowlist ---------------------------------------------------
# Optional. Email address granted the Admin role on first login. Previously this
# was hardcoded directly into docker-compose.prod.yml, which made the tracked file
# permanently dirty on the VPS and blocked safe fast-forward deploys.
ADMIN_EMAIL_0=CHANGE_ME

# ---- Notes on variables that are NOT in this file --------------------------
# - ASPNETCORE_ENVIRONMENT is hardcoded to "Production" in docker-compose.prod.yml, not
#   configurable here, so a misconfigured .env can never accidentally leave the API in dev mode.
# - Waypoint__DataProtection__KeysDirectory is hardcoded to /keys (a persistent Docker volume) in
#   docker-compose.prod.yml. See docs/HOSTINGER_DEPLOYMENT.md's Data Protection section.
# - The FIRST admin email is templated above as ADMIN_EMAIL_0 (docker-compose.prod.yml maps it to
#   Waypoint__AdminEmails__0). Additional admins (Waypoint__AdminEmails__1, ...) and any moderator
#   allowlist (Waypoint__ModeratorEmails__0, ...) are not templated, since the array-index env var
#   syntax doesn't generalize to a fixed template. If you need more, add both the .env variable and
#   the matching mapping line in docker-compose.prod.yml — see docs/ENVIRONMENT_VARIABLES.md.
# - Waypoint__Notifications__Push__MaxPerUserPerDay / PollingIntervalSeconds /
#   DailyReminderLocalTime are optional push-notification tuning values with safe defaults already
#   in code (3 / 120 / "09:00") — not templated here since most deployments won't need to override
#   them. Add any of them directly to docker-compose.prod.yml's `api` service if you do.
