# Used by docker-compose.yml
POSTGRES_PASSWORD=waypoint_dev_password
WEB_APP_BASE_URL=http://localhost:3030
ASPNETCORE_ENVIRONMENT=Development

# Required for Waypoint Coach (Phase 6) to work at all — without this,
# AnthropicAiService throws AiServiceUnavailableException on every AI request.
# docker-compose.yml passes this through to the api service automatically now
# (see docs/PRODUCTION_READINESS_AUDIT.md section 19) — just set it here or export
# it in your shell before running `docker compose up`.
ANTHROPIC_API_KEY=

# Comma-free, one per line is not supported by plain env vars — ASP.NET Core's array
# binding convention for a config array like Waypoint:AdminEmails is
# Waypoint__AdminEmails__0, Waypoint__AdminEmails__1, etc. See
# docs/13-production-readiness-phase12.md for the full list of required production
# environment variables and this array-binding syntax in context.
#
# Same array-binding syntax applies to Waypoint:ModeratorEmails
# (Waypoint__ModeratorEmails__0, etc.) — a least-privilege role scoped to the moderation
# queue and mentor verification only, distinct from full Admin. See
# docs/PRODUCTION_READINESS_AUDIT.md's Authorization section. Empty by default, same
# safe-by-default reasoning as AdminEmails.

# Real transactional email (registration confirmation, password reset). Leave
# Email__Smtp__Host unset/empty and the API safely falls back to logging emails to
# the console instead of sending them (see LoggingEmailSender) — this is the
# Development default and is intentional; it does NOT mean email is broken, it means
# no real mail relay has been configured yet. Set these to a real SMTP relay
# (your own mail server, or a transactional-email provider's SMTP endpoint) only when
# you're ready for the API to actually send real email to real users.
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromAddress=no-reply@example.com
Email__Smtp__FromName=Waypoint
